    <script src="<%=domainURL%>/js/jquery.min.js"></script>

    <script type="text/javascript">
      // محاسبه ratio بر اساس ابعاد واقعی صفحه نمایش کاربر
      const defaultRatio = 2.168; // ratio پیش‌فرض برای حالت landscape
      let baseRatio =
        window.innerHeight > window.innerWidth
          ? window.innerHeight / window.innerWidth
          : defaultRatio;

      let vh = window.innerHeight * 0.01;
      document.documentElement.style.setProperty("--vh", `${vh}px`);
      document.documentElement.style.setProperty("--ratio", `${baseRatio}`);

      window.addEventListener("resize", () => {
        if (window.innerHeight > window.innerWidth) {
          // حالت portrait: ratio رو از ابعاد واقعی صفحه محاسبه می‌کنیم
          baseRatio = window.innerHeight / window.innerWidth;
          vh = window.innerHeight * 0.01;
          document.documentElement.style.setProperty("--vh", `${vh}px`);
          document.documentElement.style.setProperty("--ratio", `${baseRatio}`);

          if (window.innerHeight / window.innerWidth > baseRatio) {
            vh = window.innerWidth * 0.01 * baseRatio;
            document.documentElement.style.setProperty("--vh", `${vh}px`);

            let diff = window.innerHeight - window.innerWidth * baseRatio;
            document.documentElement.style.setProperty(
              "--margin",
              `${diff / 2}px`
            );
          }
        } else {
          // حالت landscape: از ratio پیش‌فرض استفاده می‌کنیم
          baseRatio = defaultRatio;
          vh = window.innerHeight * 0.01;
          document.documentElement.style.setProperty("--vh", `${vh}px`);
          document.documentElement.style.setProperty("--ratio", `${baseRatio}`);
        }
      });

      if (window.innerHeight > window.innerWidth) {
        if (window.innerHeight / window.innerWidth > baseRatio) {
          vh = window.innerWidth * 0.01 * baseRatio;
          document.documentElement.style.setProperty("--vh", `${vh}px`);

          let diff = window.innerHeight - window.innerWidth * baseRatio;
          document.documentElement.style.setProperty(
            "--margin",
            `${diff / 2}px`
          );
        }
      } else {
        baseRatio = defaultRatio;
        vh = window.innerHeight * 0.01;
        document.documentElement.style.setProperty("--vh", `${vh}px`);
        document.documentElement.style.setProperty("--ratio", `${baseRatio}`);

        // document.documentElement.style.setProperty('--vw', `${(vh / 1.78)}px`);
      }
    </script>
    <script type="text/javascript">
      var timerStarted = false;
      var submitCompleted = false;
      var timerCount = new Date().getTime() + 120000;

      function startTimer() {
        timerCount = new Date().getTime() + 120000;
        if(timerStarted) return;
        timerStarted = true;
        var x = setInterval(function() {

          // Get todays date and time
          var now = new Date().getTime();


          // Find the distance between now and the count down date
          var distance = timerCount - now;

          // Time calculations for days, hours, minutes and seconds
          var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          var seconds = Math.floor((distance % (1000 * 60)) / 1000);

          // Display the result in the element with id="demo"

          var foo = '';
          if(seconds < 10) seconds = '0' + seconds;
          foo = minutes + ":" + seconds;
          foo = toPersianNumber(foo);
          $('.timer').html(foo);

          if (distance < 0) {
            $('.timer').html('۰:۰۰');
            clearInterval(x);
            timerStarted = false;
            $('.layer3 .alert').text('');
            $('.layer3 ._text3').addClass('hide');
            $('.layer3 ._text4').removeClass('hide');
          }

        }, 1000);
      }

        function replaceAll(string, search, replace) {
            return string.split(search).join(replace);
        }
        var getUrlParameter = function getUrlParameter(sParam) {
            var sPageURL = decodeURIComponent(window.location.search.substring(1)), sParameterName;
            sPageURL = sPageURL.split('&');
            for (var i = 0; i < sPageURL.length; i++) {
                if(sPageURL[i].indexOf(sParam) !== -1) {
                    sParameterName = sPageURL[i].split(sParam + '=');
                    return sParameterName[1];
                }
            }
            return '';
        };

        $(window).ready(function () {
            $('#preloader').delay(200).fadeOut('fade');

            var currentPage = 1;
            var moving = false;

            $('.page1_btn').on('click', function (e) {
                e.preventDefault();
                <%if(!!user.profile) {%>
                return window.location.href = '/game';
                <%}%>
                $('.layer2').css('display', 'block');
                $('.layer2').animate({left: "0"}, 1000 );
                $('.layer1').animate({left: "-100%"}, 1000);
                setTimeout(()=>{
                    $('.layer1').css('display', 'none');
                    moving = false;
                    currentPage++;
                }, 1000);
            });

          $('#phone').on('keypress', function (event) {
            event.preventDefault();
            var regex = new RegExp("^[0-9۰-۹]*$");
            var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
            if (!regex.test(key)) {
              return false;
            }
            $('#phone').val($('#phone').val() + toPersianNumber(key));
            var val = $('#phone').val();
            if (val.length > 11) $('#phone').val(val.slice(0, 11));
          });

          $('#sms').on('keypress', function (event) {
            event.preventDefault();
            var regex = new RegExp("^[0-9۰-۹]*$");
            var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
            if (!regex.test(key)) {
              return false;
            }
            $('#sms').val($('#sms').val() + toPersianNumber(key));
            var val = $('#sms').val();
            if (val.length > 5) $('#sms').val(val.slice(0, 5));
          });

          $('#phone').on('keyup', ()=> {
            if($('#phone').val() === '') {
              $('.layer2 .page2_btn').removeClass('active').attr('disabled', 'disabled');
            } else {
              $('.layer2 .page2_btn').addClass('active').removeAttr('disabled');
            }
          });

          $('#sms').on('keyup', ()=> {
            if($('#sms').val() === '') {
              $('.layer3 .page3_btn').removeClass('active').attr('disabled', 'disabled');
            } else {
              $('.layer3 .page3_btn').addClass('active').removeAttr('disabled');
            }
          });

          let acceptAjax = true;
          let resend = false;

          $('.resendSms').on('click', function (e) {
            e.preventDefault();
            $('.layer3 ._text4').addClass('hide');
            $('#login-form').trigger('submit');
            resend = true;
          });

          $('#login-form').on('submit', function (e) {
            e.preventDefault();
            if (acceptAjax) {
              acceptAjax = false;

              $('#login-form button').html('<span class="fa fa-spinner fa-spin" style="font-size: calc(2.5* var(--vh)); margin: 0; color: #fff; left: calc(55* var(--vh) / var(--ratio)); top: calc(1.5* var(--vh)); width: calc(3* var(--vh)); height: calc(3* var(--vh));"></span>');
              // $('#login-form button').html('');

              const data = new FormData(this);
              const alert = $('#login-form .alert');
              const input = $('#login-form input');
              alert.removeClass('alert-error alert-success').addClass('hide');
              input.removeClass('input-error input-success');

              $.ajax({
                type: "POST",
                url: '<%=domainURL%>/sendSmsCode',
                data: data,
                processData: false,
                contentType: false,
                cache: false,
                async: true,
                headers: {
                  "cache-control": "no-cache"
                },
                success: function (res) {
                  if (res.status === 500) {
                    alert.text('خطا در ارسال کد ورود!');
                    alert.removeClass('hide').addClass('alert-error');
                    input.addClass('input-error');
                  } else if (res.status === 501) {
                    alert.text(' خطا! ' + (res.error?.['phone'] || 'شماره تلفن خود را وارد کنید'));
                    alert.removeClass('hide').addClass('alert-error');
                    input.addClass('input-error');

                  } else if (res.status === 502) {
                    alert.text('خطا در ارسال کد ورود!');
                    alert.removeClass('hide').addClass('alert-error');
                    input.addClass('input-error');

                  } else if (res.status === 425) {
                    alert.text(res.message);
                    alert.removeClass('hide').addClass('alert-error');
                    input.addClass('input-error');

                  } else if (res.status === 200) {
                    alert.text('کد ورود برایتان ارسال شد');
                    alert.removeClass('hide').addClass('alert-success');
                    input.addClass('input-success');
                    $('#sms-form .phone').val($('#login-form .phone').val());
                    $('#sms-form .month').val($('#login-form .month').val());
                    $('.layer3 .phoneSpan').html($('#login-form .phone').val());
                    startTimer();

                    if (!resend) {
                      setTimeout(()=>{
                        $('.layer3').css('display', 'block');
                        $('.layer3').animate({left: "0"}, 1000 );
                        $('.layer2').animate({left: "-100%"}, 1000);
                        setTimeout(()=>{
                          $('.layer2').css('display', 'none');
                          moving = false;
                        }, 1000);
                      }, 1000);
                    } else {
                      $('.layer3 ._text4').addClass('hide');
                    }



                  }
                  setTimeout(function () {
                    acceptAjax = true;
                    $('#login-form button').html('');
                    return true;
                  }, 2000);
                },
                error: function () {
                  // alert("اینترنت خود را بررسی نمایید!");
                  setTimeout(function () {
                    acceptAjax = true;
                    $('#login-form button').html('');
                    return true;
                  }, 2000);
                }
              });

            }
          });

          $('#sms-form').on('submit', function (e) {
            e.preventDefault();

            if (acceptAjax) {
              acceptAjax = false;
              $('#sms-form button').html('<span class="fa fa-spinner fa-spin" style="font-size: calc(2.5* var(--vh)); margin: 0; color: #fff; left: calc(55* var(--vh) / var(--ratio)); top: calc(1.5* var(--vh)); width: calc(3* var(--vh)); height: calc(3* var(--vh));"></span>');

              $('.layer3 ._text3').addClass('hide');
              $('.layer3 ._text4').addClass('hide');

              var data = new FormData(this);
              var alert = jQuery('#sms-form .alert');
              var input = jQuery('#sms-form input');
              alert.removeClass('alert-error alert-success').addClass('hide');
              input.removeClass('input-error input-success');

              $.ajax({
                type: "POST",
                url: '<%=domainURL%>/verifyCode?link=' + getUrlParameter('friend'),
                data: data,
                processData: false,
                contentType: false,
                cache: false,
                async: true,
                headers: {
                  "cache-control": "no-cache"
                },
                success: function (res) {
                  if (res.status === 500) {
                    alert.text('خطا در سرور! لطفا به ما اطلاع دهید. باتشکر');
                    alert.removeClass('hide').addClass('alert-error');
                    input.addClass('input-error');
                  } else if (res.status === 501) {
                    alert.text('خطا! ' + (res.error['phone'] || res.error['sms']));
                    alert.removeClass('hide').addClass('alert-error');
                    input.addClass('input-error');
                  } else if (res.status === 400) {
                    alert.text('خطا! کد وارد شده معتبر نیست.');
                    alert.removeClass('hide').addClass('alert-error');
                    input.addClass('input-error');
                  } else if (res.status === 200) {
                    alert.text('کد ورود تایید شد.');
                    alert.removeClass('hide').addClass('alert-success');
                    input.addClass('input-success');
                    return window.location.href = ('<%=domainURL%>/game' + window.location.search);

                  } else {
                    alert.text('خطا! کد وارد شده معتبر نیست.');
                    alert.removeClass('hide').addClass('alert-error');
                    input.addClass('input-error');
                  }
                  setTimeout(function () {
                    acceptAjax = true;
                    $('#sms-form button').html('');
                    return true;
                  }, 1000);
                },
                error: function () {
                  // alert("اینترنت خود را بررسی نمایید!");
                  setTimeout(function () {
                    acceptAjax = true;
                    $('#sms-form button').html('');
                    return true;
                  }, 2000);
                  return false;
                }
              });

            }
          });

        });
    </script>
  </body>
</html>
