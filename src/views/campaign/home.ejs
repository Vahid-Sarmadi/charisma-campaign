        $(".vam-modal .check-btn").on("click", function () {
          checkMissionCompletion("vamHeal", ".vam-modal");
        });

        // Handle phone input for share form
        $(".copyToClipboard").on("click", function (e) {
          var $temp = $("<input>");
          $("body").append($temp);
          $temp.val($(".copyToClipboard").data("value")).select();
          document.execCommand("copy");
          $temp.remove();

          var tooltip = $("#myTooltip");
          tooltip.text("آدرس بازی کپی شد");
          tooltip.fadeIn();
          setTimeout(function () {
            tooltip.fadeOut();
