          $(".layer1").removeClass("active-tab");
          $(".layer2").addClass("active-tab");
          $(".layer3").removeClass("active-tab");
        });
        $(".tab-3").on("click", () => {
          $(".tab-3").addClass("active-nav");
          $(".tab-1").removeClass("active-nav");
          $(".tab-2").removeClass("active-nav");
          $(".layer1").removeClass("active-tab");
          $(".layer2").removeClass("active-tab");
          $(".layer3").addClass("active-tab");
        });
        $(".lose-modal .btn").on("click", () => {
