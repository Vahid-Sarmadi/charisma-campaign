        $(".mission-vam").on("click", () => {
          showModal(".vam-modal");
        });

        // Social media mission handlers
        $(".mission-instagram").on("click", () => {
          window.open("https://www.instagram.com/charismaholding", "_blank");
          addHeal("instagram");
        });

        $(".mission-telegram").on("click", () => {
          window.open("https://t.me/charismaholding", "_blank");
          addHeal("telegram");
        });

        $(".mission-twitter").on("click", () => {
          window.open("https://x.com/CharismaHolding", "_blank");
          addHeal("twitter");
        });

        $(".mission-linkedin").on("click", () => {
          window.open(
            "https://www.linkedin.com/company/charisma-financial-services-group/",
            "_blank"
          );
          addHeal("linkedin");
        });

        $(".mission-modal .close").on("click", function () {
          hideModal(".mission-modal");
        });
        $(".lose-modal .close").on("click", function () {
          hideModal(".lose-modal");
        });
        $(".app-modal .btn").on("click", function () {
          addHeal("app");
        });
        $(".app-modal .check-btn").on("click", function () {
          hideModal(".lose-modal");
          window.location.reload();
        });

        $(".install-modal .check-btn").on("click", function () {
          checkMissionCompletion("registerHeal", ".install-modal");
        });

        $(".tarh-modal .check-btn").on("click", function () {
          checkMissionCompletion("tarhHeal", ".tarh-modal");
        });

        $(".sandoogh-modal .check-btn").on("click", function () {
          checkMissionCompletion("sandooghHeal", ".sandoogh-modal");
        });

        $(".tabdil-modal .check-btn").on("click", function () {
          checkMissionCompletion("tabdilHeal", ".tabdil-modal");
