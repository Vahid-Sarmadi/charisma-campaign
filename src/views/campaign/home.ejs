    <script type="text/javascript">
      // محاسبه ratio بر اساس ابعاد واقعی صفحه نمایش کاربر
      const defaultRatio = 2.168; // ratio پیش‌فرض برای حالت landscape
      let baseRatio = defaultRatio;

      let vh = window.innerHeight * 0.01;
      document.documentElement.style.setProperty("--vh", `${vh}px`);
      document.documentElement.style.setProperty("--ratio", `${baseRatio}`);

      window.addEventListener("resize", () => {
        loadProgressBar(playerInfo.score);
        if (window.innerHeight > window.innerWidth) {
          // حالت portrait: ratio رو از ابعاد واقعی صفحه محاسبه می‌کنیم
          baseRatio = window.innerHeight / window.innerWidth;
          vh = window.innerHeight * 0.01;
          document.documentElement.style.setProperty("--vh", `${vh}px`);
          document.documentElement.style.setProperty("--ratio", `${baseRatio}`);

          if (window.innerHeight / window.innerWidth > baseRatio) {
            vh = window.innerWidth * 0.01 * baseRatio;
            document.documentElement.style.setProperty("--vh", `${vh}px`);

            let diff = window.innerHeight - window.innerWidth * baseRatio;
            document.documentElement.style.setProperty(
              "--margin",
              `${diff / 2}px`
            );
          }
        } else {
          // حالت landscape: از ratio پیش‌فرض استفاده می‌کنیم
          baseRatio = defaultRatio;
          vh = window.innerHeight * 0.01;
          document.documentElement.style.setProperty("--vh", `${vh}px`);
          document.documentElement.style.setProperty("--ratio", `${baseRatio}`);
        }
      });

      if (window.innerHeight > window.innerWidth) {
        if (window.innerHeight / window.innerWidth > baseRatio) {
          vh = window.innerWidth * 0.01 * baseRatio;
          document.documentElement.style.setProperty("--vh", `${vh}px`);

          let diff = window.innerHeight - window.innerWidth * baseRatio;
          document.documentElement.style.setProperty(
            "--margin",
            `${diff / 2}px`
          );
        }
      } else {
        baseRatio = defaultRatio;
        vh = window.innerHeight * 0.01;
        document.documentElement.style.setProperty("--vh", `${vh}px`);
        document.documentElement.style.setProperty("--ratio", `${baseRatio}`);

        // document.documentElement.style.setProperty('--vw', `${(vh / 1.78)}px`);
      }
    </script>
    <script type="text/javascript">
      function replaceAll(string, search, replace) {
        return string.split(search).join(replace);
      }
      var getUrlParameter = function getUrlParameter(sParam) {
        var sPageURL = decodeURIComponent(window.location.search.substring(1)),
          sParameterName;
        sPageURL = sPageURL.split("&");
        for (var i = 0; i < sPageURL.length; i++) {
          if (sPageURL[i].indexOf(sParam) !== -1) {
            sParameterName = sPageURL[i].split(sParam + "=");
            return sParameterName[1];
          }
        }
        return "";
      };

      var forceBlurEffect = false;
      function blurEffect(flag) {
        if (flag === "show") {
          $(".blurEffect").show();
        } else if (!forceBlurEffect) {
          $(".blurEffect").hide();
        }
      }

      var acceptAjax = true;
      var playerInfo = "<%=JSON.stringify(profile)%>";

      // playerInfo = JSON.parse(playerInfo.replaceAll('&#34;', "\""));
      playerInfo = JSON.parse(replaceAll(playerInfo, "&#34;", '"'));

      function showModal(className) {
        forceBlurEffect = true;
        setTimeout(function () {
          blurEffect("show");
          $(className).removeClass("hide");
          $(className)
            .find(".wrapper")
            .addClass("animate__animated animate__bounceInUp");
          setTimeout(function () {
            $(className)
              .find(".wrapper")
              .removeClass(
                "animate__animated animate__bounceInUp animate__bounceOutDown"
              );
          }, 1000);
        }, 1000);
      }

      function hideModal(className) {
        forceBlurEffect = false;
        $(className)
          .find(".wrapper")
          .addClass("animate__animated animate__bounceOutDown");
        setTimeout(function () {
          blurEffect("hide");
          $(className).addClass("hide");
          $(className)
            .find(".wrapper")
            .removeClass(
              "animate__animated animate__bounceInUp animate__bounceOutDown"
            );
        }, 1000);
      }

      var allowSkip = false;
      let isDragging = false;

      let showHelp = true;
      let moving = false;
      let clearCount = 0;

      let timerStarted = false;
      let pause = false;
      let timerCount = new Date().getTime() + 30000;

      let instagramTry = 0;

      function startTimer() {
        if (timerStarted) return;
        timerStarted = true;
        document.getElementById("clock-sound").play();
        var x = setInterval(function () {
          if (pause) return;
          // Get todays date and time
          var now = new Date().getTime();

          // Find the distance between now and the count down date
          var distance = timerCount - now;

          // Time calculations for days, hours, minutes and seconds
          var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          var seconds = Math.floor((distance % (1000 * 60)) / 1000);

          // Display the result in the element with id="demo"

          var foo = "";
          if (seconds < 10) seconds = "0" + seconds;
          foo = minutes + ":" + seconds;
          foo = toPersianNumber(foo);
          $(".timer-wrap").html(foo);

          if (distance < 0) {
            $(".timer-wrap").html("۰۰:۰۰");
            document.getElementById("clock-sound").pause();
            clearInterval(x);
            pause = true;
            // showModal('.lose-modal');
            loseScore();
          }
        }, 1000);
      }

      function addHeal(type = "instagram") {
        if (!acceptAjax) return;
        acceptAjax = false;

        $.ajax({
          type: "POST",
          url: "/addHeal/" + type,
          processData: false,
          contentType: false,
          cache: false,
          async: true,
          headers: {
            "cache-control": "no-cache",
            token: "<%=csrfToken%>",
          },
          success: function (res) {
            window.location.href = "/home";

            acceptAjax = true;
          },
          error: function () {
            alert("عدم ارتباط با سرور!");
            acceptAjax = true;
            return false;
          },
        });
      }

      function loadProgressBar(score) {
        $(".progress-bar").css("height", 0 * vh);

        setTimeout(function () {
          let score_pool = [199, 499, 999, 1499];
          let progressbar_pool = [0, 0, 13.7, 23.5, 36, 36];
          if (score <= score_pool[0]) {
            $(".progress-bar").css("height", progressbar_pool[0] * vh);
            // $(".lvl1").css("height", 14.7 * vh);
          } else if (score <= score_pool[1]) {
            let diff_score = score;
            $(".progress-bar").css(
              "height",
              (progressbar_pool[1] +
                ((progressbar_pool[2] - progressbar_pool[1]) * diff_score) /
                  (score_pool[1] - score_pool[0])) *
                vh
            );
            $(".lvl1").css("height", 10 * vh);
          } else if (score <= score_pool[2]) {
            let diff_score = score - score_pool[1];
            $(".progress-bar").css(
              "height",
              (progressbar_pool[2] +
                ((progressbar_pool[3] - progressbar_pool[2]) * diff_score) /
                  (score_pool[2] - score_pool[1])) *
                vh
            );
            $(".lvl2").css("height", 10 * vh);
            $(".lvl2").css(
              "background",
              `url(<%=domainURL%>/images/lvl2.png?ver=<%=version%>)
            no-repeat right center`
            );
          } else if (score <= score_pool[3]) {
            let diff_score = score - score_pool[2];
            $(".progress-bar").css(
              "height",
              (progressbar_pool[3] +
                ((progressbar_pool[4] - progressbar_pool[3]) * diff_score) /
                  (score_pool[3] - score_pool[2])) *
                vh
            );

            $(".lvl3").css("height", 10 * vh);
            $(".lvl3").css(
              "background",
              `url(<%=domainURL%>/images/lvl3.png?ver=<%=version%>)
            no-repeat right center`
            );
          } else {
            $(".progress-bar").css("height", progressbar_pool[5] * vh);
            $(".lvl4").css("height", 10 * vh);
            $(".lvl4").css(
              "background",
              `url(<%=domainURL%>/images/lvl4.png?ver=<%=version%>)
            no-repeat right center`
            );
          }
        }, 100);
      }

      /**
       * Check mission completion by calling the API
       * @param {string} missionKey - The mission key (e.g., 'registerHeal', 'tarhHeal')
       * @param {string} modalSelector - The modal selector (e.g., '.app-modal')
       */
      function checkMissionCompletion(missionKey, modalSelector) {
        if (!acceptAjax) return;
        acceptAjax = false;

        const modal = $(modalSelector);
        const checkBtn = modal.find(".check-btn");
        const alert = modal.find(".alert");
        const originalBtnContent = checkBtn.html();

        // Show loading state
        checkBtn.css("opacity", "0.5").css("pointer-events", "none");

        $.ajax({
          type: "POST",
          url: "/missions/check/" + missionKey,
          processData: false,
          contentType: false,
          cache: false,
          async: true,
          headers: {
            "cache-control": "no-cache",
            token: "<%=csrfToken%>",
          },
          success: function (res) {
            checkBtn.css("opacity", "1").css("pointer-events", "auto");

            if (res.status === 200) {
              if (res.completed) {
                // Mission completed successfully
                alert.removeClass("hide alert-error").addClass("alert-success");
                alert.text(
                  `تبریک! ماموریت انجام شد! +${res.healAdded} جون اضافه شد`
                );

                // Update heal display
                $(".heal-text").html(toPersianNumber(res.totalHeal.toString()));

                // Close modal after 2 seconds
                setTimeout(() => {
                  hideModal(modalSelector);
                  acceptAjax = true;
                  window.location.reload();
                }, 2000);
              } else {
                // Mission not yet completed
                alert.removeClass("hide alert-success").addClass("alert-error");
                alert.text(
                  "ماموریت هنوز انجام نشده است. لطفا ابتدا ماموریت را انجام دهید."
                );
                acceptAjax = true;
              }
            } else {
              alert.removeClass("hide alert-success").addClass("alert-error");
              alert.text(res.message || "خطا در بررسی ماموریت");
              acceptAjax = true;
            }
          },
          error: function () {
            checkBtn.css("opacity", "1").css("pointer-events", "auto");
            alert.removeClass("hide alert-success").addClass("alert-error");
            alert.text("خطا در ارتباط با سرور!");
            acceptAjax = true;
          },
        });
      }

      $(window).ready(function () {
        $("#preloader").delay(200).fadeOut("fade");
        loadProgressBar(playerInfo.score);

        // اگر جون منفی بود، صفر نشون بده
        if (playerInfo.heal < 0) {
          $(".heal-text").html(toPersianNumber("0"));
        }

        // غیرفعال کردن دکمه شروع بازی اگر جون صفر یا کمتر بود
        if (playerInfo.heal <= 0) {
          showModal(".lose-modal");
          $("#start-btn-link").addClass("disabled");
          $("#start-btn-link").on("click", function (e) {
            e.preventDefault();
            return false;
          });
        }

        $(".tab-1").on("click", () => {
