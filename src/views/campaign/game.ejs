                );
                moving = false;
                startTimer();
                pause = false;
                setTimeout(() => {
                  if (!showHelp || playerInfo.heal <= 0) return;
                  $(".hand").removeClass("hide");
                }, 3000);
              }, 1000);
            }, 1000);
          }
        }

        $(".start-modal-1 .btn").on("click", function () {
          start();
        });
        $(".start-modal-2 .btn").on("click", function () {
