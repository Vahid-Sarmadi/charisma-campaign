        height: calc(6.8 * var(--vh));
        width: calc(50 * var(--vh) / var(--ratio));
        top: calc(60 * var(--vh));
        margin-left: calc(39 * var(--vh) / var(--ratio));
        position: absolute;
        cursor: pointer;
      }

      #preloader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 99999999;
        background: linear-gradient(45deg, #43627c 0%, #121e29 100%);
      }
      #loader {
        display: block;
        position: relative;
        left: 50%;
        top: 50%;
        width: 80px;
        height: 80px;
        margin: -75px 0 0 -75px;
        border-radius: 50%;
        border: 3px solid transparent;
        border-top-color: #9fa19f;
        -webkit-animation: spin 2s linear infinite;
        animation: spin 2s linear infinite;
      }
      #loader:before {
        content: "";
        position: absolute;
        top: 5px;
        left: 5px;
        right: 5px;
        bottom: 5px;
        border-radius: 50%;
        border: 3px solid transparent;
        border-top-color: #d14923;
        -webkit-animation: spin 3s linear infinite;
        animation: spin 3s linear infinite;
      }
      #loader:after {
        content: "";
        position: absolute;
        top: 15px;
        left: 15px;
        right: 15px;
        bottom: 15px;
        border-radius: 50%;
        border: 3px solid transparent;
        border-top-color: #ff0606;
        -webkit-animation: spin 1.5s linear infinite;
        animation: spin 1.5s linear infinite;
      }

      @media only screen and (min-width: 320px) and (max-width: 768px) {
        #loader {
          left: 60%;
        }
      }

      /* حرکت خورشید از چپ به راست (06:00 تا 18:00) */
      @keyframes sunMove {
        0% {
          margin-left: calc(-25 * var(--vh) / var(--ratio));
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-20px);
        }
        100% {
          margin-left: calc(100 * var(--vh) / var(--ratio));
          transform: translateY(0px);
        }
      }

      /* حرکت ماه از چپ به راست (18:00 تا 06:00) */
      @keyframes moonMove {
        0% {
          margin-left: calc(-25 * var(--vh) / var(--ratio));
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-20px);
        }
        100% {
          margin-left: calc(100 * var(--vh) / var(--ratio));
          transform: translateY(0px);
        }
      }

      /* Hide scrollbars */
      ::-webkit-scrollbar {
        display: none;
      }

      * {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      /* Animated Chart Styles */
      .layer1 .chart {
        position: absolute;
        height: calc(32 * var(--vh));
        width: calc(87 * var(--vh) / var(--ratio));
        top: calc(25 * var(--vh));
        margin-left: calc(7 * var(--vh) / var(--ratio));
        z-index: 10;
      }

      .chart-container {
        position: relative;
        width: 100%;
        height: 100%;
        border: calc(0.3 * var(--vh)) solid #7addf1;
        box-shadow: 0 0 calc(1 * var(--vh)) #7addf1,
          inset 0 0 calc(1 * var(--vh)) rgba(0, 212, 255, 0.2);
        background: linear-gradient(
          135deg,
          rgba(18, 30, 41, 0.8) 0%,
          rgba(30, 50, 70, 0.6) 100%
        );
        overflow: hidden;
      }

      .chart-grid-lines {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        opacity: 0.3;
      }

      .grid-line-h {
        position: absolute;
        width: 100%;
        height: calc(0.1 * var(--vh));
        border-top: calc(0.05 * var(--vh)) solid #00d4ff;
        left: 0;
      }

      .grid-line-v {
        position: absolute;
        width: calc(0.1 * var(--vh));
        height: 100%;
        border-left: calc(0.05 * var(--vh)) solid #00d4ff;
        top: 0;
      }

      .chart-svg-container {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
      }

      svg.animated-chart {
        width: 100%;
        height: 100%;
      }

      .chart-line {
        fill: none;
        stroke: #ffd700;
        stroke-width: calc(0.3 * var(--vh));
        stroke-linecap: round;
        stroke-linejoin: round;
        filter: drop-shadow(0 0 calc(0.5 * var(--vh)) #ffd700);
        stroke-dasharray: none;
        stroke-dashoffset: 0;
      }

      .chart-fill {
        fill: url(#chartGradient);
        opacity: 0;
      }

      /* Coin Animation Styles */
      .coin-animation {
        position: absolute;
        font-size: calc(3 * var(--vh));
        font-weight: bold;
        pointer-events: none;
        z-index: 50;
        animation: coinFloat 1s ease-out forwards;
        right: 50%;
        bottom: 50%;
        transform: translateX(50%);
      }

      .coin-animation.positive {
        color: #22a958;
        text-shadow: 0 0 calc(0.5 * var(--vh)) #22a958;
      }

      .coin-animation.negative {
        color: #df1d17;
        text-shadow: 0 0 calc(0.5 * var(--vh)) #df1d17;
      }

      @keyframes coinFloat {
        0% {
          opacity: 1;
          transform: translateX(50%) translateY(0);
        }
        100% {
          opacity: 0;
          transform: translateX(50%) translateY(calc(-10 * var(--vh)));
        }
      }
    </style>
  </head>
