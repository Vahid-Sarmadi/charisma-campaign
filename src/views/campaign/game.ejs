                setTimeout(() => {
                  if (!showHelp || playerInfo.heal <= 0) return;
                  $(".hand").removeClass("hide");
                }, 3000);
              }, 1000);
            }, 1000);
          } else if (playerInfo.giftLevel === 4) {
            timerCount = new Date().getTime() + 18000;
            hideModal(".start-modal-3");
            setTimeout(() => {
              $(".layer3 .description-box").removeClass("hide");
              $(".layer3 .domestos-on").removeClass("hide");
