      function makeDraggable(draggableSelector, dropZoneSelectors) {
        const el = document.querySelector(draggableSelector);
        const dropZones = document.querySelectorAll(dropZoneSelectors); // Select all drop zones
        if (!el || dropZones.length === 0) return;

        // Store original positions (from the CSS)
        const originalLeft = el.style.left;
        const originalTop = el.style.top;

        let offsetX = 0,
          offsetY = 0;
        let isDragging = false;
        let canMove = true;

        // MOUSE DOWN
        el.addEventListener("pointerdown", function (e) {
          if (!acceptAjax || !canMove) return;
          isDragging = true;
          canMove = false;
          showHelp = false;
          $(".hand").addClass("hide");
          el.classList.add("scale3");

          el.style.cursor = "grabbing";

          // The offset between mouse and element’s current top-left
          offsetX = e.clientX - el.offsetLeft;
          offsetY = e.clientY - el.offsetTop;

          el.setPointerCapture(e.pointerId);
        });

        // MOUSE MOVE
        el.addEventListener("pointermove", function (e) {
          if (!acceptAjax || !isDragging) return;
          el.style.left = e.clientX - offsetX + "px";
          el.style.top = e.clientY - offsetY + "px";
        });

        // MOUSE UP
        el.addEventListener("pointerup", function (e) {
          if (!acceptAjax || !isDragging) return;
          isDragging = false;

          el.style.cursor = "grab";

          // Check for overlap with any drop zone
          let overlapped = false;
          const mouseX = e.clientX;
          const mouseY = e.clientY;

          dropZones.forEach((dropZone) => {
            if (
              dropZone.classList.contains("clear-shadow") ||
              dropZone.classList.contains("clear-shadow2")
            ) {
              return; // Skip drop zones that are already cleared
            }

            const dropRect = dropZone.getBoundingClientRect();
            const overlap =
              mouseX >= dropRect.left &&
              mouseX <= dropRect.right &&
              mouseY >= dropRect.top &&
              mouseY <= dropRect.bottom;

            if (overlap) {
              if ($(dropZone).hasClass("temp")) return;
              overlapped = true;
              $(".spray-foam").removeClass("hide");

              el.classList.add("animate__animated", "spray-effect");
              $(dropZone).addClass("temp");
              // When the animation ends, handle the drop zone
              el.addEventListener("animationend", function handler() {
                el.classList.remove("animate__animated", "spray-effect");
                el.classList.remove("scale3");
                el.removeEventListener("animationend", handler);
                $(dropZone).fadeOut();

                canMove = true;
                clearCount++;
                if (playerInfo.giftLevel >= 4) {
                  if (clearCount >= 5) {
                    pause = true;
                    document.getElementById("clock-sound").pause();
                    $(".shine-effect").removeClass("hide");
                    setTimeout(() => {
                      submitScore();
                      if (playerInfo.giftLevel < 2) showModal(".win-modal-1");
                      else if (playerInfo.giftLevel < 4)
                        showModal(".win-modal-2");
                      else if (playerInfo.giftLevel < 6)
                        showModal(".win-modal-3");
                    }, 2000);
                  }
                } else if (clearCount >= 4) {
                  pause = true;
                  document.getElementById("clock-sound").pause();
                  $(".shine-effect").removeClass("hide");
                  setTimeout(() => {
                    submitScore();
                    submitScore();
                    if (playerInfo.giftLevel < 2) showModal(".win-modal-1");
                    else if (playerInfo.giftLevel < 4)
                      showModal(".win-modal-2");
                    else if (playerInfo.giftLevel < 6)
                      showModal(".win-modal-3");
                  }, 2000);
                }

                // Add shadow class based on playerInfo.giftLevel
                // if (playerInfo.giftLevel === 0 || playerInfo.giftLevel === 2 || playerInfo.giftLevel === 5) {
                //   document.getElementById('win-sound').play();
                //   $(dropZone).find('.shadow').addClass('clear-shadow');
                // } else {
                //   $(dropZone).find('.shadow').addClass('clear-shadow2');
                // }

                // Move the element back to original location
                el.style.left = originalLeft;
                el.style.top = originalTop;
                el.releasePointerCapture(e.pointerId);
              });
            }
          });

          // If no overlap with any drop zone, reset the element
          if (!overlapped) {
            el.classList.remove("scale3");
            el.style.left = originalLeft;
            el.style.top = originalTop;
            el.releasePointerCapture(e.pointerId);
            canMove = true;
          }
        });
      }

