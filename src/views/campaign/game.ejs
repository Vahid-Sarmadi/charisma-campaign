    <script type="text/javascript">
      let baseRatio = 2.168;
      let vh = window.innerHeight * 0.01;
      document.documentElement.style.setProperty("--vh", `${vh}px`);
      document.documentElement.style.setProperty("--ratio", `${baseRatio}`);

      window.addEventListener("resize", () => {
        if (window.innerHeight > window.innerWidth) {
          baseRatio = 2.168;
          vh = window.innerHeight * 0.01;
          document.documentElement.style.setProperty("--vh", `${vh}px`);
          document.documentElement.style.setProperty("--ratio", `${baseRatio}`);

          if (window.innerHeight / window.innerWidth > baseRatio) {
            vh = window.innerWidth * 0.01 * baseRatio;
            document.documentElement.style.setProperty("--vh", `${vh}px`);

            let diff = window.innerHeight - window.innerWidth * baseRatio;
            document.documentElement.style.setProperty(
              "--margin",
              `${diff / 2}px`
            );
          }
        } else {
          baseRatio = 2.168;
          vh = window.innerHeight * 0.01;
          document.documentElement.style.setProperty("--vh", `${vh}px`);
          document.documentElement.style.setProperty("--ratio", `${baseRatio}`);
        }
      });

      if (window.innerHeight > window.innerWidth) {
        if (window.innerHeight / window.innerWidth > baseRatio) {
          vh = window.innerWidth * 0.01 * baseRatio;
          document.documentElement.style.setProperty("--vh", `${vh}px`);

          let diff = window.innerHeight - window.innerWidth * baseRatio;
          document.documentElement.style.setProperty(
            "--margin",
            `${diff / 2}px`
          );
        }
      } else {
        baseRatio = 2.168;
        vh = window.innerHeight * 0.01;
        document.documentElement.style.setProperty("--vh", `${vh}px`);
        document.documentElement.style.setProperty("--ratio", `${baseRatio}`);

        // document.documentElement.style.setProperty('--vw', `${(vh / 1.78)}px`);
      }
    </script>
    <script type="text/javascript">
      function replaceAll(string, search, replace) {
        return string.split(search).join(replace);
      }
      var getUrlParameter = function getUrlParameter(sParam) {
        var sPageURL = decodeURIComponent(window.location.search.substring(1)),
          sParameterName;
        sPageURL = sPageURL.split("&");
        for (var i = 0; i < sPageURL.length; i++) {
          if (sPageURL[i].indexOf(sParam) !== -1) {
            sParameterName = sPageURL[i].split(sParam + "=");
            return sParameterName[1];
          }
        }
        return "";
      };

      var forceBlurEffect = false;
      function blurEffect(flag) {
        if (flag === "show") {
          $(".blurEffect").show();
        } else if (!forceBlurEffect) {
          $(".blurEffect").hide();
        }
      }

      var acceptAjax = true;
      var playerInfo = "<%=JSON.stringify(profile)%>";

      // playerInfo = JSON.parse(playerInfo.replaceAll('&#34;', "\""));
      playerInfo = JSON.parse(replaceAll(playerInfo, "&#34;", '"'));

      function showModal(className) {
        forceBlurEffect = true;
        setTimeout(function () {
          blurEffect("show");
          $(className).removeClass("hide");
          $(className)
            .find(".wrapper")
            .addClass("animate__animated animate__bounceInUp");
          setTimeout(function () {
            $(className)
              .find(".wrapper")
              .removeClass(
                "animate__animated animate__bounceInUp animate__bounceOutDown"
              );
          }, 1000);
        }, 1000);
      }

      function hideModal(className) {
        forceBlurEffect = false;
        $(className)
          .find(".wrapper")
          .addClass("animate__animated animate__bounceOutDown");
        setTimeout(function () {
          blurEffect("hide");
          $(className).addClass("hide");
          $(className)
            .find(".wrapper")
            .removeClass(
              "animate__animated animate__bounceInUp animate__bounceOutDown"
            );
        }, 1000);
      }

      var allowSkip = false;
      let isDragging = false;

      function submitScore(score = 1, type = "none") {
        if (!acceptAjax) return;
        acceptAjax = false;

        let payload = CryptoJS.AES.encrypt(score.toString(), "<%=csrfToken%>");
        payload = encodeURIComponent(payload);
        $.ajax({
          type: "POST",
          url: "/submitScore/" + payload,
          processData: false,
          contentType: false,
          cache: false,
          async: true,
          headers: {
            "cache-control": "no-cache",
            token: "<%=csrfToken%>",
          },
          success: function (res) {
            acceptAjax = true;
          },
          error: function () {
            alert("عدم ارتباط با سرور!");
            acceptAjax = true;
            return false;
          },
        });
      }

      let showHelp = true;
      let moving = false;
      let clearCount = 0;

      let timerStarted = false;
      let pause = false;
      let timerCount = new Date().getTime() + 30000;

      let instagramTry = 0;

      let nightVisionShown = false;
      let winModalShown = false;

      // Toggle state between sabet and gold
      let activeMode = "sabet"; // Default mode

      // Game Logic Variables
      let gameLogic = null;
      let chartDataPoints = [];
      let gameStartTime = null;
      let scoreCheckInterval = null;

      function startTimer() {
        if (timerStarted) return;
        timerStarted = true;

        // شروع تایمر از 06:00 AM و طی کردن 24 ساعت در 1 دقیقه
        // 24 ساعت = 86400 ثانیه
        // در 1 دقیقه = 60 ثانیه
        // بنابراین هر ثانیه واقعی = 1440 ثانیه در بازی (86400/60)

        const startHour = 6; // 06:00 AM
        const startMinute = 0;
        const totalSecondsInDay = 24 * 60 * 60; // 86400 ثانیه
        const gameDurationMs = 60 * 1000; // 1 دقیقه = 60000 میلی‌ثانیه

        gameStartTime = new Date().getTime();

        // Initialize game logic with chart data
        if (!gameLogic && chartDataPoints.length > 0) {
          gameLogic = new GameLogic(chartDataPoints);
          startScoreChecking();
        }

        var x = setInterval(function () {
          if (pause) return;

          // محاسبه زمان سپری‌شده از شروع بازی
          var elapsedMs = new Date().getTime() - gameStartTime;

          // اگر زمان بیشتر از 1 دقیقه شد، تایمر تمام شده
          if (elapsedMs >= gameDurationMs) {
            $(".chart-timer").html("06:00:00");
            clearInterval(x);
            pause = true;
            // باز کردن مودال برد
            if (!winModalShown) {
              winModalShown = true;

              // دریافت امتیاز نهایی و نمایش در مودال
              if (gameLogic) {
                const finalScore = gameLogic.getScore();
                $(".score-modal").html(
                  "+" + toPersianNumber(finalScore.toString())
                );
                // ثبت امتیاز کاربر
                submitScore(finalScore);
              }

              hideModal(".night-vision-modal");
              showModal(".win-modal");
            }
            return;
          }

          // محاسبه درصد پیشرفت (0 تا 1)
          var progress = elapsedMs / gameDurationMs;

          // محاسبه ثانیه‌های سپری‌شده در یک روز (0 تا 86400)
          var secondsInDay = progress * totalSecondsInDay;

          // تبدیل به ساعت و دقیقه و ثانیه
          var totalSeconds = Math.floor(secondsInDay);
          var hours = Math.floor(totalSeconds / 3600) + startHour;
          var minutes = Math.floor((totalSeconds % 3600) / 60);
          var seconds = totalSeconds % 60;

          // اگر ساعت از 24 بیشتر شد، به روز بعد برود
          if (hours >= 24) {
            hours = hours - 24;
          }

          // کنترل خورشید و ماه و بکگراند
          if (hours >= 6 && hours < 18) {
            // روز است - خورشید فعال، ماه غیرفعال
            $(".layer1 .sun").addClass("active");
            $(".layer1 .moon").removeClass("active");
            $(".layer1 .bg").removeClass("night-bg").addClass("day-bg");
          } else {
            // شب است - ماه فعال، خورشید غیرفعال

            // چک کن اگه hasNightVision برابر false است
            if (!playerInfo.hasNightVision && !nightVisionShown) {
              nightVisionShown = true;
              showModal(".night-vision-modal");
              // blur کردن چارت وقتی کاربر night vision ندارد
              $(".layer1 .chart").addClass("blurred");
            } else if (playerInfo.hasNightVision) {
              // اگر کاربر night vision دارد، blur را حذف کن
              $(".layer1 .chart").removeClass("blurred");
            }
            $(".layer1 .chart-btn").removeClass("hide");
            $(".layer1 .sun").removeClass("active");
            $(".layer1 .moon").addClass("active");
            $(".layer1 .bg").removeClass("day-bg").addClass("night-bg");
          }

          // چک کن اگه ساعت به 18 (6 عصر) رسید
          // if (
          //   hours === 18 &&
          //   minutes === 0 &&
          //   seconds === 0 &&
          //   !nightVisionShown
          // ) {
          //   nightVisionShown = true;
          //   // چک کن اگه hasNightVision برابر false است
          //   if (!playerInfo.hasNightVision) {
          //     showModal(".night-vision-modal");
          //   }
          // }

          // فرمت‌بندی (ساعت، دقیقه و ثانیه)
          var hourStr = hours < 10 ? "0" + hours : hours;
          var minuteStr = minutes < 10 ? "0" + minutes : minutes;
          var secondStr = seconds < 10 ? "0" + seconds : seconds;
          var timeStr = hourStr + ":" + minuteStr + ":" + secondStr;

          // نمایش با فونت انگلیسی (بدون تبدیل به فارسی)
          $(".chart-timer").html(timeStr);
        }, 100); // هر 100 میلی‌ثانیه به‌روزرسانی کن برای دقت بیشتر
      }

      /**
       * Start checking score every interval
       * 48 data points × interval = 60 seconds (game duration)
       * So interval = 60000 / 48 = 1250 milliseconds
       */
      let shadowUpdateInterval = null;

      function startScoreChecking() {
        if (scoreCheckInterval) {
          clearInterval(scoreCheckInterval);
        }

        // Check score every 1 second to sync with chart trend
        const checkInterval = 500; // 1 second

        scoreCheckInterval = setInterval(() => {
          if (!gameLogic || pause) return;

          // Check and update score
          gameLogic.checkAndUpdateScore();

          // Update score display
          updateScoreDisplay();

          // Move to next data point
          gameLogic.nextDataPoint();
        }, checkInterval);

        // Update shadow every 500ms (half second)
        if (shadowUpdateInterval) {
          clearInterval(shadowUpdateInterval);
        }
        shadowUpdateInterval = setInterval(() => {
          if (!gameLogic || pause) return;
          updatePartialChartFill();
        }, 500);
      }

      /**
       * Update score display on UI
       */
      function updateScoreDisplay() {
        if (!gameLogic) return;
        const score = gameLogic.getScore();
        $(".score-text").html(toPersianNumber(score.toString()));
      }

      /**
       * Load chart data from JSON file
       * Randomly selects one of 5 chart data files (chart-data-1.json to chart-data-5.json)
       */
      function loadChartData() {
        // Select a random number from 1 to 5
        const randomNumber = Math.floor(Math.random() * 5) + 1;
        const chartDataUrl = `<%=domainURL%>/data/chart-data-${randomNumber}.json`;

        // Load chart data from randomly selected JSON file
        fetch(chartDataUrl)
          .then((response) => response.json())
          .then((data) => {
            chartDataPoints = data;
            // Update chart visualization after loading data
            updateChartVisualization();
          })
          .catch((error) => {
            console.error("Error loading chart data:", error);
            // Fallback: use empty array if loading fails
            chartDataPoints = [];
          });
      }

      /**
       * Generate SVG path from chart data
       * Shows a sliding window of 30 points from the full 240-point chart
       */
      function generateChartPath() {
        if (chartDataPoints.length === 0) return "";

        // Window size: show 30 points at a time
        const windowSize = 30;
        const totalPoints = chartDataPoints.length;

        // Get the visible window of data points
        const visiblePoints = chartDataPoints.slice(0, windowSize);

        // Find min and max values for scaling (from visible window)
        const values = visiblePoints.map((d) => d.value);
        const minValue = Math.min(...values);
        const maxValue = Math.max(...values);
        const valueRange = maxValue - minValue || 1;

        // SVG dimensions
        const svgWidth = 1000;
        const svgHeight = 400;
        const padding = 20;

        // Generate points for visible window
        let points = [];
        visiblePoints.forEach((data, index) => {
          const x =
            (index / (windowSize - 1)) * (svgWidth - 2 * padding) + padding;
          const normalizedValue = (data.value - minValue) / valueRange;
          const y =
            svgHeight - (normalizedValue * (svgHeight - 2 * padding) + padding);
          points.push(`${x},${y}`);
        });

        return points.join(" ");
      }

      /**
       * Generate SVG fill path from chart data
       * Shows a sliding window of 30 points from the full 240-point chart
       */
      function generateChartFillPath() {
        if (chartDataPoints.length === 0) return "";

        // Window size: show 30 points at a time
        const windowSize = 30;

        // Get the visible window of data points
        const visiblePoints = chartDataPoints.slice(0, windowSize);

        // Find min and max values for scaling (from visible window)
        const values = visiblePoints.map((d) => d.value);
        const minValue = Math.min(...values);
        const maxValue = Math.max(...values);
        const valueRange = maxValue - minValue || 1;

        // SVG dimensions
        const svgWidth = 1000;
        const svgHeight = 400;
        const padding = 20;

        // Generate points for fill path
        let pathData = "M ";

        // Start from bottom left
        pathData += `${padding},${svgHeight} `;

        // Add visible data points
        visiblePoints.forEach((data, index) => {
          const x =
            (index / (windowSize - 1)) * (svgWidth - 2 * padding) + padding;
          const normalizedValue = (data.value - minValue) / valueRange;
          const y =
            svgHeight - (normalizedValue * (svgHeight - 2 * padding) + padding);
          pathData += `L ${x},${y} `;
        });

        // Close the path
        pathData += `L ${svgWidth - padding},${svgHeight} Z`;

        return pathData;
      }

      /**
       * Update chart visualization
       */
      function updateChartVisualization() {
        const polyline = document.querySelector(".chart-line");
        const fillPath = document.querySelector(".chart-fill");

        if (polyline) {
          polyline.setAttribute("points", generateChartPath());
        }

        if (fillPath) {
          fillPath.setAttribute("d", generateChartFillPath());
        }
      }

      /**
       * Generate partial SVG line path based on progress
       * Shows a sliding window of 30 points, with animation within the window
       */
      function generatePartialChartLinePath(progress) {
        if (chartDataPoints.length === 0 || progress <= 0) return "";

        const windowSize = 30;
        const totalPoints = chartDataPoints.length;

        // Calculate which window we're in based on progress
        // progress goes from 0 to 1 as we move through all 240 points
        const currentIndex = Math.floor(totalPoints * progress);

        // Calculate the start of the visible window
        // The window should follow the current index
        let windowStart = Math.max(
          0,
          currentIndex - Math.floor(windowSize / 2)
        );
        let windowEnd = windowStart + windowSize;

        // If we're near the end, adjust the window
        if (windowEnd > totalPoints) {
          windowEnd = totalPoints;
          windowStart = Math.max(0, windowEnd - windowSize);
        }

        // Get the visible window of data points
        const visiblePoints = chartDataPoints.slice(windowStart, windowEnd);

        // Find min and max values for scaling (from visible window)
        const values = visiblePoints.map((d) => d.value);
        const minValue = Math.min(...values);
        const maxValue = Math.max(...values);
        const valueRange = maxValue - minValue || 1;

        // SVG dimensions
        const svgWidth = 1000;
        const svgHeight = 400;
        const padding = 20;

        // Calculate how much of the window has been traversed
        const progressInWindow = (currentIndex - windowStart) / windowSize;
        const pointsToShowInWindow = Math.ceil(
          visiblePoints.length * progressInWindow
        );

        if (pointsToShowInWindow < 1) return ""; // Need at least 1 point

        let points = [];

        // Add visible data points up to current progress
        for (let i = 0; i < pointsToShowInWindow; i++) {
          const data = visiblePoints[i];
          const x =
            (i / (visiblePoints.length - 1)) * (svgWidth - 2 * padding) +
            padding;
          const normalizedValue = (data.value - minValue) / valueRange;
          const y =
            svgHeight - (normalizedValue * (svgHeight - 2 * padding) + padding);
          points.push(`${x},${y}`);
        }

        return points.join(" ");
      }

      /**
       * Generate partial SVG fill path based on progress
       * Shows a sliding window of 30 points, with shadow animation within the window
       */
      function generatePartialChartFillPath(progress) {
        if (chartDataPoints.length === 0 || progress <= 0) return "";

        const windowSize = 30;
        const totalPoints = chartDataPoints.length;

        // Calculate which window we're in based on progress
        const currentIndex = Math.floor(totalPoints * progress);

        // Calculate the start of the visible window
        let windowStart = Math.max(
          0,
          currentIndex - Math.floor(windowSize / 2)
        );
        let windowEnd = windowStart + windowSize;

        // If we're near the end, adjust the window
        if (windowEnd > totalPoints) {
          windowEnd = totalPoints;
          windowStart = Math.max(0, windowEnd - windowSize);
        }

        // Get the visible window of data points
        const visiblePoints = chartDataPoints.slice(windowStart, windowEnd);

        // Find min and max values for scaling (from visible window)
        const values = visiblePoints.map((d) => d.value);
        const minValue = Math.min(...values);
        const maxValue = Math.max(...values);
        const valueRange = maxValue - minValue || 1;

        // SVG dimensions
        const svgWidth = 1000;
        const svgHeight = 400;
        const padding = 20;

        // Calculate how much of the window has been traversed
        const progressInWindow = (currentIndex - windowStart) / windowSize;
        const pointsToShowInWindow = Math.ceil(
          visiblePoints.length * progressInWindow
        );

        if (pointsToShowInWindow < 2) return ""; // Need at least 2 points

        let pathData = "M ";

        // Start from bottom left
        pathData += `${padding},${svgHeight} `;

        // Add visible data points up to current progress
        for (let i = 0; i < pointsToShowInWindow; i++) {
          const data = visiblePoints[i];
          const x =
            (i / (visiblePoints.length - 1)) * (svgWidth - 2 * padding) +
            padding;
          const normalizedValue = (data.value - minValue) / valueRange;
          const y =
            svgHeight - (normalizedValue * (svgHeight - 2 * padding) + padding);
          pathData += `L ${x},${y} `;
        }

        // Close the path at the bottom
        const lastX =
          ((pointsToShowInWindow - 1) / (visiblePoints.length - 1)) *
            (svgWidth - 2 * padding) +
          padding;
        pathData += `L ${lastX},${svgHeight} Z`;

        return pathData;
      }

      /**
       * Update partial chart fill and line based on game progress
       */
      function updatePartialChartFill() {
        if (!gameLogic) return;

        const fillPath = document.querySelector(".chart-fill");
        const chartLine = document.querySelector(".chart-line");
        const progress = gameLogic.getProgress();

        if (fillPath) {
          fillPath.setAttribute("d", generatePartialChartFillPath(progress));
          // Update opacity based on progress (0 to 0.4)
          fillPath.style.opacity = progress * 0.4;
        }

        if (chartLine) {
          chartLine.setAttribute(
            "points",
            generatePartialChartLinePath(progress)
          );
        }
      }

      // Generate grid lines for the chart
      function generateGridLines() {
        const gridContainer = document.getElementById("gridLines");
        if (!gridContainer) return;

        const rows = 8;
        const cols = 10;

        // Create horizontal lines
        for (let i = 1; i < rows; i++) {
          const line = document.createElement("div");
          line.className = "grid-line-h";
          line.style.top = i * (100 / rows) + "%";
          gridContainer.appendChild(line);
        }

        // Create vertical lines
        for (let i = 1; i < cols; i++) {
          const line = document.createElement("div");
          line.className = "grid-line-v";
          line.style.left = i * (100 / cols) + "%";
          gridContainer.appendChild(line);
        }
      }

      $(window).ready(function () {
        $("#preloader").delay(200).fadeOut("fade");

        // Load chart data (async)
        loadChartData();

        // Generate grid lines
        generateGridLines();

        setTimeout(() => {
          showModal(".help-modal");
        }, 500);

        $(".help-modal .close").on("click", function () {
          hideModal(".help-modal");
          $(".chart-svg-container").removeClass("hide");
          startTimer();
        });

        $(".help-modal .btn").on("click", function () {
          hideModal(".help-modal");
          $(".chart-svg-container").removeClass("hide");
          startTimer();
        });

        $(".night-vision-modal .close").on("click", function () {
          hideModal(".night-vision-modal");
        });

        $(".chart-btn").on("click", function () {
          showModal(".night-vision-modal");
        });

        $(".to-persian").each(function () {
          $(this).html(toPersianNumber($(this).html()));
        });

        // Initialize active mode
        $(".sabet-btn").addClass("active");
        $(".gold-btn").removeClass("active");

        // Toggle between sabet and gold modes
        $(".start-btn").on("click", function () {
          if (activeMode === "sabet") {
            activeMode = "gold";
            $(".sabet-btn").removeClass("active");
            $(".gold-btn").addClass("active");
          } else {
            activeMode = "sabet";
            $(".gold-btn").removeClass("active");
            $(".sabet-btn").addClass("active");
          }

          // Update game logic mode
          if (gameLogic) {
            gameLogic.setMode(activeMode);
          }
        });
      });
    </script>
  </body>
</html>
