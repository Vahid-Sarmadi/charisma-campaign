      }
      .spray-effect {
        animation: sprayShake 2s ease-in-out forwards;
      }

      .clear-shadow {
        animation: clearShadow 3s ease-in-out forwards;
      }

      .clear-shadow2 {
        animation: clearShadow2 3s ease-in-out forwards;
      }

      /* Keyframes: The spray starts small (0% scale) and near the bottle tip,
         then moves outward, grows a bit, and fades away (opacity = 0). */
      @keyframes sprayShake {
        0%   { transform: rotate(10deg)    scale(0.8);   }
        20%  { transform: rotate(15deg)   scale(0.85); }
        40%  { transform: rotate(5deg)    scale(0.8);   }
        60%  { transform: rotate(15deg)   scale(0.85); }
        80%  { transform: rotate(5deg)    scale(0.8);   }
        100% { transform: rotate(10deg)    scale(0.8);   }
      }

      @keyframes shineFrames {
        0%   { transform: rotate(0deg)    scale(0.5);   }
        50%  { transform: rotate(80deg)    scale(1);   }
        100% { transform: rotate(0deg)    scale(0.5);   }
      }

      /*help*/
      @keyframes help {
        0% {transform: translateX(0) translateY(0) scale(1);}
        100% {transform: translateX(calc(-25 * var(--vh) / var(--ratio))) translateY(calc(-25 * var(--vh))) scale(1.5);}
      }

      /* Firefox < 16 */
      @-moz-keyframes help {
        0% {transform: translateX(0) translateY(0) scale(1);}
        100% {transform: translateX(calc(-25 * var(--vh) / var(--ratio))) translateY(calc(-25 * var(--vh))) scale(1.5);}
      }

      /* Safari, Chrome and Opera > 12.1 */
      @-webkit-keyframes help {
        0% {transform: translateX(0) translateY(0) scale(1);}
        100% {transform: translateX(calc(-25 * var(--vh) / var(--ratio))) translateY(calc(-25 * var(--vh))) scale(1.5);}
      }


      /* Internet Explorer */
      @-ms-keyframes help {
        0% {transform: translateX(0) translateY(0) scale(1);}
        100% {transform: translateX(calc(-25 * var(--vh) / var(--ratio))) translateY(calc(-25 * var(--vh))) scale(1.5);}
      }

