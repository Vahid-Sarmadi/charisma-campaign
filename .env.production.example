# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env.production and fill in the actual values

# Database Configuration
# Use MongoDB connection string with authentication
DB_URI=mongodb://root:password@mongo:27017/charisma-landing-db?authSource=admin
DB_NAME=charisma-landing-db
DB_USER=root
DB_PASS=your_secure_password_here

# MongoDB Credentials for Docker Compose
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=your_secure_mongo_password_here

# Campaign Domain
CAMPAIGN_URL=https://talabaz.charisma.ir

# Global Settings
SESSION_SECRET=your_very_secure_session_secret_here_change_this
PORT=3000
NODE_ENV=production

# Version
VERSION=1.0.1

# Charisma OAuth2 Authentication
CHARISMA_AUTH_URL=https://apig-is.charisma.tech/oauth2/token
CHARISMA_CLIENT_ID=your_client_id
CHARISMA_CLIENT_SECRET=your_client_secret
CHARISMA_SCOPE=chr_marketing

# Charisma API
CHARISMA_API_URL=https://apig-gw.charisma.tech/gam/v1.0

# Mediana API
MEDIANA_API_URL=https://api.mediana.ir/v1/otp/send
MEDIANA_API_KEY=your_mediana_api_key
MEDIANA_PATTERN_CODE=your_mediana_pattern_code

# Optional: Logging and Monitoring
LOG_LEVEL=info
